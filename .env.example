# Hedera Network Configuration
NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_HEDERA_ACCOUNT_ID=0.0.123456
HEDERA_PRIVATE_KEY=302e020100300506032b6570042204201234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Hedera Mirror Node API
NEXT_PUBLIC_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Smart Contract Addresses (Update after deployment)
NEXT_PUBLIC_INVOICE_FACTORING_CONTRACT=0.0.000000
NEXT_PUBLIC_INSURANCE_POOL_CONTRACT=0.0.000000

# HCS Topic IDs (Update after creation)
NEXT_PUBLIC_AUDIT_TOPIC_ID=0.0.000000
NEXT_PUBLIC_SETTLEMENT_TOPIC_ID=0.0.000000

# HFS File IDs (Update after creation)
NEXT_PUBLIC_DOCUMENT_STORAGE_FILE_ID=0.0.000000

# Application Configuration
NEXT_PUBLIC_APP_NAME="Real Yield Hedera"
NEXT_PUBLIC_APP_DESCRIPTION="Unlock $2 Trillion Realworld Liquidity into Blockchain powered by Hedera Hashgraph"

# Oracle Integration (Optional)
ORACLE_API_KEY=your_oracle_api_key_here
ORACLE_ENDPOINT=https://api.oracle-provider.com

# Development Settings
NODE_ENV=development
NEXT_PUBLIC_DEBUG=true

# Security (Production only)
# JWT_SECRET=your_jwt_secret_here
# ENCRYPTION_KEY=your_encryption_key_here

# Database (If using external DB)
# DATABASE_URL=postgresql://username:password@localhost:5432/real_yield_hedera

# Third-party Services
# SENDGRID_API_KEY=your_sendgrid_key_here
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# Analytics (Optional)
# GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
# MIXPANEL_TOKEN=your_mixpanel_token

# Monitoring (Optional)
# SENTRY_DSN=your_sentry_dsn
# DATADOG_API_KEY=your_datadog_key